# ── Catalyst Platform ──────────────────────────────────────
CATALYST_PROJECT_ID=your_catalyst_project_id
CATALYST_PROJECT_KEY=your_catalyst_project_key
CATALYST_ENV=development
CATALYST_DATA_STORE_URL=https://datastore.catalystapps.com
CATALYST_QUICKML_API_KEY=your_quickml_api_key
CATALYST_ZIA_OCR_API=https://zia.zoho.com/api/v1/ocr
CATALYST_ZIA_SPEECH_API=https://zia.zoho.com/api/v1/speech
CATALYST_AUTH_SECRET=your_catalyst_auth_secret

# ── App Security ───────────────────────────────────────────
# REQUIRED in production — generate: python -c "import secrets; print(secrets.token_hex(32))"
VV_TOKEN_SECRET=change_me_in_production

# ── Google APIs ────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_GEOCODING_API_KEY=your_geocoding_api_key
GEMINI_API_KEY=your_gemini_api_key

# ── SMS Alerts (MSG91) ─────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=VVPOL
MSG91_TEMPLATE_ID=your_msg91_template_id

# ── Training data storage ──────────────────────────────────
# In AppSail this is /app/training_data (set by Dockerfile)
# Locally leave blank to use backend/training_data/
VV_TRAINING_DATA_DIR=

# ── CORS (comma-separated origins) ────────────────────────
# In AppSail this is set via appsail.json environment
# Locally leave blank — defaults to localhost:3000 / 5173
ALLOWED_ORIGINS_STR=

# ── Catalyst Stratus buckets ───────────────────────────────
# Create these buckets in Catalyst Console → Stratus before deploying
CATALYST_STRATUS_BUCKET_TRAINING=vv-training-data

# ── RPi5 Edge Unit Integration ─────────────────────────────────
# Shared HMAC-SHA256 secret between RPi5 and this Catalyst backend.
# MUST match RPI_WEBHOOK_SECRET in the RPi5's .env file.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
RPI_WEBHOOK_SECRET=rpi5_vv_default_secret_change_me

# Police station email — receives HIGH + CRITICAL email alerts from RPi5
POLICE_STATION_EMAIL=police.station@gov.in

# Catalyst Data Store table names (create these tables in Catalyst Console)
# RpiIncidentTable — stores all RPi5 road accident incidents
# DeviceTokenTable — stores police officer FCM tokens for push notifications
RPI_INCIDENT_TABLE=RpiIncidentTable
DEVICE_TOKEN_TABLE=DeviceTokenTable
