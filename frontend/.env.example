# ── Local development ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

# ── Catalyst production (API Gateway URLs) ─────────────────────────
# After deploying via `catalyst deploy`, replace with your real URLs:
#   Console → API Gateway → Copy endpoint
#
# VITE_API_URL=https://<project-domain>.zohocloud.com/server/apigw/v1
# Function-level direct invocations (if not going through API Gateway):
# VITE_FIR_API_URL=https://<project-domain>.zohocloud.com/server/fir-api
# VITE_AI_URL=https://<project-domain>.zohocloud.com/server/ai-orchestrator
# VITE_ANALYTICS_URL=https://<project-domain>.zohocloud.com/server/crime-analytics

# ── Google Maps (via Catalyst Connections in production) ───────────
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ── App metadata ───────────────────────────────────────────────────
VITE_APP_NAME=VigilanteVanguard
VITE_CATALYST_ENV=development
